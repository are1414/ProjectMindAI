@model PersonRequest
@{
    ProjectResponse project = ViewBag.Project;
    int? personId = ViewBag.PersonId;
    var isEdit = personId is not null;
    ViewData["Title"] = isEdit ? "Kişiyi düzenle" : "Yeni kişi";
}

<a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="small text-decoration-none">← @project.Name</a>
<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-projectId="@project.Id" asp-route-id="@personId"
      method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="WeeklyCapacityHours" class="form-label"></label>
            <input asp-for="WeeklyCapacityHours" class="form-control" step="0.5" />
            <span asp-validation-for="WeeklyCapacityHours" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="HourlyCost" class="form-label"></label>
            <input asp-for="HourlyCost" class="form-control" step="any" />
            <span asp-validation-for="HourlyCost" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label class="form-label d-block">Beceriler</label>
            @foreach (var skill in Enum.GetValues<Skill>().Where(s => s != Skill.None))
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="Skills" value="@skill" id="skill-@skill"
                           checked="@Model.Skills.Contains(skill)" />
                    <label class="form-check-label" for="skill-@skill">@Display.Name(skill)</label>
                </div>
            }
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" asp-fragment="people" class="btn btn-link">Vazgeç</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
