@model ProjectRequest
@{
    ViewData["Title"] = "Projeyi düzenle";
    int projectId = ViewBag.ProjectId;
}

<h1 class="h3 mb-3">Projeyi düzenle</h1>
<form asp-action="Edit" asp-route-id="@projectId" method="post" class="card card-body">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Details" asp-route-id="@projectId" class="btn btn-link">Vazgeç</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
