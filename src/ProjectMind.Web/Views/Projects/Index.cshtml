@model IReadOnlyList<ProjectResponse>
@{ ViewData["Title"] = "Projeler"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Projeler</h1>
    <a class="btn btn-primary" asp-action="Create">+ Yeni proje</a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center text-muted border rounded p-5">
        <p class="mb-3">Henüz proje yok. İlk adım: projeyi tanımlayın.</p>
        <a class="btn btn-primary" asp-action="Create">Proje oluştur</a>
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Proje</th><th>Tip</th><th>Durum</th><th>Başlangıç</th><th>Hedef bitiş</th><th class="text-end">Bütçe</th></tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold">@p.Name</a></td>
                <td>@Display.Name(p.Type)</td>
                <td><span class="badge text-bg-secondary">@Display.Name(p.Status)</span></td>
                <td>@Display.Date(p.StartDate)</td>
                <td>@Display.Date(p.TargetEndDate)</td>
                <td class="text-end">@Display.Money(p.Budget, p.Currency)</td>
            </tr>
        }
        </tbody>
    </table>
}
