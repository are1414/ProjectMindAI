@model ProjectRequest
@{ ViewData["Title"] = "Yeni proje"; }

<h1 class="h3 mb-3">Yeni proje</h1>
<p class="text-muted">1. adım: Projeyi tanımlayın. Ardından işleri ve kişileri ekleyeceksiniz.</p>
<form asp-action="Create" method="post" class="card card-body">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-link">Vazgeç</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
