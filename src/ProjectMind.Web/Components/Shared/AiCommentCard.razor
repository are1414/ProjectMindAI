@* AI analiz yorumu kartı (Durum ve What-if sekmeleri). Sadece gösterim: üretim/önbellek/geçmiş ProjectCommentService'te.
   Buton: kayıtlı yorum varsa önce "Son yorumu göster" (LLM çağrılmaz), ardından "Yeni yorum al" (LLM). Geçmiş listesinden
   önceki yorumlar açılabilir; bugünkü veriden farklı girdiyle üretilenler "eski veri" uyarısıyla gösterilir.
   "Anlaşılır mıydı?" geri bildirimi ProjectCommentService.RateAsync ile gösterilen yorumun AiAnalysisLog kaydına yazılır (RQ4). *@
@inject AppScope Scope

<section class="ai-comment" aria-live="polite">
    <div class="section-head">
        <h2>AI yorumu</h2>
        @if (ShowsLatestFirst)
        {
            <button class="btn btn-sm" disabled="@Busy" @onclick="ShowLatest"
                    title="Kaydedilmiş son yorumu açar; AI çağrılmaz.">Son yorumu göster</button>
        }
        else
        {
            <button class="btn btn-sm" disabled="@Busy" @onclick="OnGenerate">
                @(Busy ? "Yorum hazırlanıyor…" : History.Count > 0 || Shown?.Comment is not null ? "Yeni yorum al" : "AI yorumu üret")
            </button>
        }
    </div>

    @if (Shown is null)
    {
        <p class="muted small">@Hint</p>
    }
    else if (Shown.Status == AnalysisCommentStatus.NotConfigured)
    {
        <div class="ai-comment-warning">▲ @Shown.Message</div>
    }
    else if (Shown.Status == AnalysisCommentStatus.Failed)
    {
        <div class="inline-error">@Shown.Message</div>
    }
    else if (Shown.Comment is { } c)
    {
        @if (Shown.IsStale)
        {
            <div class="ai-comment-warning">
                ▲ Bu yorum @Date(Shown.CreatedAt) tarihindeki verilere göre üretildi; veriler o zamandan beri değişti.
                Güncel yorum için "Yeni yorum al"a basın.
            </div>
        }
        <p class="ai-comment-summary">@c.Summary</p>
        @if (c.KeyFindings.Count > 0)
        {
            <h3>Önemli bulgular</h3>
            <ul>@foreach (var x in c.KeyFindings) { <li>@x</li> }</ul>
        }
        @if (c.RecommendedActions.Count > 0)
        {
            <h3>Önerilen aksiyonlar</h3>
            <ul>@foreach (var x in c.RecommendedActions) { <li>@x</li> }</ul>
        }
        @if (c.Caveats.Count > 0)
        {
            <h3>Varsayımlar ve sınırlar</h3>
            <ul class="muted">@foreach (var x in c.Caveats) { <li>@x</li> }</ul>
        }
        @if (Shown.UnverifiedNumbers is { Count: > 0 } unverified)
        {
            <div class="ai-comment-warning">
                ▲ Doğrulanamayan sayılar: @string.Join(", ", unverified) — bu değerler sistem verisinde yok, kontrol edin.
            </div>
        }
        <p class="muted small">
            @Shown.Model@(Shown.CreatedAt is { } at ? $" · {Date(at)}" : "")@(Shown.FromCache ? Shown.IsStale ? " · kaydedilmiş yorum" : " · kaydedilmiş yorum (veri değişmedi)" : "")
            · Sayılar sistem hesaplarından alınır; yorum veriyi değiştirmez.
        </p>
        @if (Shown.LogId is not null)
        {
            <div class="comment-rating">
                <span>Bu açıklama anlaşılır mıydı?</span>
                <button class="btn btn-sm @(_helpful == true ? "btn-selected" : "")" disabled="@_rating" @onclick="() => RateAsync(true, _clarity)">Evet</button>
                <button class="btn btn-sm @(_helpful == false ? "btn-selected" : "")" disabled="@_rating" @onclick="() => RateAsync(false, _clarity)">Hayır</button>
                @if (_helpful is { } helpful)
                {
                    <span class="muted small" title="1 = hiç anlaşılır değil, 5 = çok anlaşılır">Puan (isteğe bağlı):</span>
                    @for (var i = CommentRating.MinClarity; i <= CommentRating.MaxClarity; i++)
                    {
                        var value = i;
                        <button class="btn btn-sm rating-value @(_clarity == value ? "btn-selected" : "")" disabled="@_rating"
                                @onclick="() => RateAsync(helpful, value)">@value</button>
                    }
                    <span class="muted small">Kaydedildi, teşekkürler.</span>
                }
            </div>
            @if (_rateError is not null)
            {
                <div class="inline-error">@_rateError</div>
            }
        }
    }

    @if (History.Count > 0)
    {
        <details class="ai-comment-history">
            <summary>Yorum geçmişi (@History.Count)</summary>
            <ul>
                @foreach (var h in History)
                {
                    var item = h;
                    var active = item.LogId is not null && item.LogId == Shown?.LogId;
                    <li class="@(active ? "active" : "")">
                        <button class="btn btn-sm" disabled="@active" @onclick="() => Select(item)">@(active ? "Gösteriliyor" : "Göster")</button>
                        <span>@Date(item.CreatedAt) · @item.Model</span>
                        <span class="badge">@(item.IsStale ? "eski veri" : "güncel veri")</span>
                        <span class="muted small history-summary">@item.Comment?.Summary</span>
                    </li>
                }
            </ul>
        </details>
    }
</section>

@code {
    /// <summary>Son üretme denemesinin sonucu (yeni yorum, hata veya Mock uyarısı); yoksa null.</summary>
    [Parameter] public AnalysisCommentResult? Result { get; set; }

    /// <summary>Kayıtlı başarılı yorumlar, en yeni önce (ProjectCommentService geçmiş sorgusu).</summary>
    [Parameter] public IReadOnlyList<AnalysisCommentResult> History { get; set; } = [];

    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnGenerate { get; set; }
    [Parameter] public string Hint { get; set; } = "Sonuçların sade Türkçe açıklaması için butona basın.";

    private AnalysisCommentResult? _lastResult;
    private IReadOnlyList<AnalysisCommentResult>? _lastHistory;
    private AnalysisCommentResult? _selected;          // "Son yorumu göster" veya geçmişten seçilen
    private int? _ratingLogId;
    private readonly Dictionary<int, (bool? Helpful, int? Clarity)> _savedRatings = [];
    private bool? _helpful;
    private int? _clarity;
    private bool _rating;
    private string? _rateError;

    /// <summary>
    /// Gösterilen yorum: seçilen geçmiş kaydı, yoksa son üretme sonucu, yoksa girdisi bugünkü veriyle aynı olan en yeni
    /// kayıt (veri değişmediyse son yorum kendiliğinden açılır).
    /// </summary>
    private AnalysisCommentResult? Shown => _selected ?? Result ?? History.FirstOrDefault(h => !h.IsStale);

    /// <summary>Ekranda yorum yokken kayıtlı yorum varsa buton önce onu açar (AI çağrılmaz).</summary>
    private bool ShowsLatestFirst => !Busy && Shown is null && History.Count > 0;

    protected override void OnParametersSet()
    {
        // Yeni bir üretme sonucu geldiyse (yorum/hata) seçili geçmiş kaydı yerine o gösterilir.
        if (!ReferenceEquals(_lastResult, Result))
        {
            _lastResult = Result;
            if (Result is not null)
                _selected = null;
        }
        // Geçmiş yeniden yüklendiyse (veri değişti, yeni senaryo) seçili kayıt güncel haliyle eşlenir ("eski veri" bilgisi dahil).
        if (!ReferenceEquals(_lastHistory, History))
        {
            _lastHistory = History;
            if (_selected?.LogId is { } id)
                _selected = History.FirstOrDefault(h => h.LogId == id);
        }
        SyncRating();
    }

    private void ShowLatest() => Select(History[0]);

    private void Select(AnalysisCommentResult item)
    {
        _selected = item;
        SyncRating();
    }

    /// <summary>Puan düğmeleri gösterilen yorumun kaydını izler; bu oturumda verilen puan kayıttaki eski değerin önüne geçer.</summary>
    private void SyncRating()
    {
        var shown = Shown;
        if (shown?.LogId == _ratingLogId)
            return;
        _ratingLogId = shown?.LogId;
        (_helpful, _clarity) = shown?.LogId is { } id && _savedRatings.TryGetValue(id, out var saved)
            ? saved
            : (shown?.Helpful, shown?.ClarityRating);
        _rateError = null;
    }

    private static string Date(DateTime? utc) => utc is { } at ? at.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "";

    private async Task RateAsync(bool helpful, int? clarity)
    {
        if (Shown?.LogId is not { } logId)
            return;
        _rating = true;
        _rateError = null;
        try
        {
            var saved = await Scope.RunAsync<ProjectCommentService, CommentRating>(s =>
                s.RateAsync(logId, new CommentRating(helpful, clarity), CancellationToken.None));
            _helpful = saved.Helpful;
            _clarity = saved.ClarityRating;
            _savedRatings[logId] = (saved.Helpful, saved.ClarityRating);
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            _rateError = ex.Message;
        }
        finally
        {
            _rating = false;
        }
    }
}
