@* AI analiz yorumu kartı (Durum ve What-if sekmeleri). Sadece gösterim: üretim/önbellek ProjectCommentService'te.
   "Anlaşılır mıydı?" geri bildirimi ProjectCommentService.RateAsync ile yorumun AiAnalysisLog kaydına yazılır (RQ4). *@
@inject AppScope Scope

<section class="ai-comment" aria-live="polite">
    <div class="section-head">
        <h2>AI yorumu</h2>
        <button class="btn btn-sm" disabled="@Busy" @onclick="OnGenerate">
            @(Busy ? "Yorum hazırlanıyor…" : Result?.Status == AnalysisCommentStatus.Ready ? "Yeniden üret" : "AI yorumu üret")
        </button>
    </div>

    @if (Result is null)
    {
        <p class="muted small">@Hint</p>
    }
    else if (Result.Status == AnalysisCommentStatus.NotConfigured)
    {
        <div class="ai-comment-warning">▲ @Result.Message</div>
    }
    else if (Result.Status == AnalysisCommentStatus.Failed)
    {
        <div class="inline-error">@Result.Message</div>
    }
    else if (Result.Comment is { } c)
    {
        <p class="ai-comment-summary">@c.Summary</p>
        @if (c.KeyFindings.Count > 0)
        {
            <h3>Önemli bulgular</h3>
            <ul>@foreach (var x in c.KeyFindings) { <li>@x</li> }</ul>
        }
        @if (c.RecommendedActions.Count > 0)
        {
            <h3>Önerilen aksiyonlar</h3>
            <ul>@foreach (var x in c.RecommendedActions) { <li>@x</li> }</ul>
        }
        @if (c.Caveats.Count > 0)
        {
            <h3>Varsayımlar ve sınırlar</h3>
            <ul class="muted">@foreach (var x in c.Caveats) { <li>@x</li> }</ul>
        }
        @if (Result.UnverifiedNumbers is { Count: > 0 } unverified)
        {
            <div class="ai-comment-warning">
                ▲ Doğrulanamayan sayılar: @string.Join(", ", unverified) — bu değerler sistem verisinde yok, kontrol edin.
            </div>
        }
        <p class="muted small">
            @Result.Model@(Result.CreatedAt is { } at ? $" · {at.ToLocalTime():dd.MM.yyyy HH:mm}" : "")@(Result.FromCache ? " · kaydedilmiş yorum (veri değişmedi)" : "")
            · Sayılar sistem hesaplarından alınır; yorum veriyi değiştirmez.
        </p>
        @if (Result.LogId is not null)
        {
            <div class="comment-rating">
                <span>Bu açıklama anlaşılır mıydı?</span>
                <button class="btn btn-sm @(_helpful == true ? "btn-selected" : "")" disabled="@_rating" @onclick="() => RateAsync(true, _clarity)">Evet</button>
                <button class="btn btn-sm @(_helpful == false ? "btn-selected" : "")" disabled="@_rating" @onclick="() => RateAsync(false, _clarity)">Hayır</button>
                @if (_helpful is { } helpful)
                {
                    <span class="muted small" title="1 = hiç anlaşılır değil, 5 = çok anlaşılır">Puan (isteğe bağlı):</span>
                    @for (var i = CommentRating.MinClarity; i <= CommentRating.MaxClarity; i++)
                    {
                        var value = i;
                        <button class="btn btn-sm rating-value @(_clarity == value ? "btn-selected" : "")" disabled="@_rating"
                                @onclick="() => RateAsync(helpful, value)">@value</button>
                    }
                    <span class="muted small">Kaydedildi, teşekkürler.</span>
                }
            </div>
            @if (_rateError is not null)
            {
                <div class="inline-error">@_rateError</div>
            }
        }
    }
</section>

@code {
    [Parameter] public AnalysisCommentResult? Result { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnGenerate { get; set; }
    [Parameter] public string Hint { get; set; } = "Sonuçların sade Türkçe açıklaması için butona basın.";

    private AnalysisCommentResult? _ratingFor;
    private bool? _helpful;
    private int? _clarity;
    private bool _rating;
    private string? _rateError;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_ratingFor, Result))
            return;
        _ratingFor = Result;
        _helpful = Result?.Helpful;
        _clarity = Result?.ClarityRating;
        _rateError = null;
    }

    private async Task RateAsync(bool helpful, int? clarity)
    {
        if (Result?.LogId is not { } logId)
            return;
        _rating = true;
        _rateError = null;
        try
        {
            var saved = await Scope.RunAsync<ProjectCommentService, CommentRating>(s =>
                s.RateAsync(logId, new CommentRating(helpful, clarity), CancellationToken.None));
            _helpful = saved.Helpful;
            _clarity = saved.ClarityRating;
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            _rateError = ex.Message;
        }
        finally
        {
            _rating = false;
        }
    }
}
