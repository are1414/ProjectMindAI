@inject AppScope Scope

@if (Overview is null)
{
    <div class="empty-project">
        <h2>Proje henüz oluşturulmadı</h2>
        <p>Sağdaki sohbete projenizi anlatın. Örneğin:</p>
        <p class="example">"E-ticaret sitesi projesi açalım. 1 Aralık'ta başlasın, 4 ay sürsün, bütçe 2 milyon TL."</p>
        <p class="muted">AI bir öneri kartı hazırlar; <strong>Uygula</strong> dediğinizde proje burada görünür.</p>
    </div>
}
else
{
    var p = Overview.Project;
    <header class="project-header">
        <div>
            <h1>@p.Name</h1>
            <div class="muted">@Format.Name(p.Type) · <span class="badge">@Format.Name(p.Status)</span></div>
            @if (!string.IsNullOrWhiteSpace(p.Description))
            {
                <p class="description">@p.Description</p>
            }
        </div>
    </header>

    <div class="stats">
        <div class="stat"><span>Başlangıç</span><strong>@Format.Date(p.StartDate)</strong></div>
        <div class="stat"><span>Hedef bitiş</span><strong>@Format.Date(p.TargetEndDate)</strong></div>
        <div class="stat"><span>Bütçe</span><strong>@Format.Money(p.Budget, p.Currency)</strong></div>
        <div class="stat"><span>Toplam tahmini efor</span><strong>@Format.Number(Overview.TotalEstimatedHours) saat</strong></div>
    </div>

    <nav class="tabs">
        <button class="tab @(_tab == Tab.Work ? "active" : "")" @onclick="() => _tab = Tab.Work">İşler (@Overview.WorkItems.Count)</button>
        <button class="tab @(_tab == Tab.Plan ? "active" : "")" @onclick="() => _tab = Tab.Plan">Plan (Gantt)</button>
        <button class="tab @(_tab == Tab.Team ? "active" : "")" @onclick="() => _tab = Tab.Team">Ekip (@Overview.People.Count)</button>
    </nav>

    @if (_tab == Tab.Plan)
    {
        <PlanPanel ProjectId="Overview.Project.Id" Overview="Overview" OnDataChanged="OnDataChanged" />
    }
    else if (_tab == Tab.Work)
    {
    <div class="section-head">
        <h2>İşler <span class="count">@Overview.WorkItems.Count</span></h2>
        @if (Overview.WorkItems.Any(w => w.ParentId is not null))
        {
            <div class="section-tools">
                <button class="btn btn-sm" @onclick="ExpandAll">Tümünü aç</button>
                <button class="btn btn-sm" @onclick="CollapseAll">Tümünü kapat</button>
            </div>
        }
    </div>
    @if (_error is not null)
    {
        <div class="inline-error">@_error</div>
    }
    @if (Overview.WorkItems.Count == 0)
    {
        <p class="muted">Henüz iş yok. Sohbette yapılacak işleri anlatın. İşler alt işlere bölünebilir: "Backend işinin altına Login API ekle".</p>
    }
    else
    {
        <table class="table table-compact">
            <thead>
                <tr><th class="col-wbs">WBS</th><th>İş</th><th>Beceri</th><th>Öncelik</th><th class="num">Efor (s)</th><th>Atanan</th><th>Durum</th><th class="num">%</th></tr>
            </thead>
            <tbody>
                @foreach (var row in VisibleRows())
                {
                    var w = row.Item;
                    <tr class="@(row.HasChildren ? "row-parent" : "")" title="@Format.Name(w.Phase)">
                        <td class="col-wbs muted">@row.Code</td>
                        <td>
                            <span class="tree-name" style="padding-left:@(row.Depth * 1.1)rem">
                                @if (row.HasChildren)
                                {
                                    <button class="tree-toggle" @onclick="() => Toggle(w.Id)" title="@(IsExpanded(w.Id) ? "Daralt" : "Genişlet")">@(IsExpanded(w.Id) ? "−" : "+")</button>
                                }
                                else
                                {
                                    <span class="tree-toggle-space"></span>
                                }
                                @if (IsEditing(w.Id, Field.Name))
                                {
                                    <input class="cell-input cell-input-wide" @bind="_editValue" @bind:event="oninput" @onkeydown="e => OnKeyAsync(e, w)" @onfocusout="() => SaveAsync(w)" autofocus />
                                }
                                else
                                {
                                    <span class="editable" @onclick="() => StartEdit(w.Id, Field.Name, w.Name)" title="Düzenlemek için tıklayın">@w.Name</span>
                                }
                            </span>
                        </td>
                        <td>@Format.Name(w.RequiredSkill)</td>
                        <td>@Format.Name(w.Priority)</td>
                        <td class="num">
                            @if (row.HasChildren)
                            {
                                <span title="Alt işlerin toplamı">@Format.Number(row.RollupHours)</span>
                            }
                            else if (IsEditing(w.Id, Field.Hours))
                            {
                                <input class="cell-input" @bind="_editValue" @bind:event="oninput" @onkeydown="e => OnKeyAsync(e, w)" @onfocusout="() => SaveAsync(w)" autofocus />
                            }
                            else
                            {
                                <span class="editable" @onclick="() => StartEdit(w.Id, Field.Hours, Format.Number(w.EstimatedHours))">@Format.Number(w.EstimatedHours)</span>
                            }
                        </td>
                        <td>@(row.HasChildren ? "" : Overview.PersonName(w.AssigneeId))</td>
                        <td>
                            @if (!row.HasChildren)
                            {
                                <span class="status status-@w.Status.ToString().ToLowerInvariant()">@Format.Name(w.Status)</span>
                            }
                        </td>
                        <td class="num">
                            @if (row.HasChildren)
                            {
                                <span title="Alt işlerin efora göre ağırlıklı ortalaması">@Format.Number(row.RollupPercent)</span>
                            }
                            else if (IsEditing(w.Id, Field.Percent))
                            {
                                <input class="cell-input" @bind="_editValue" @bind:event="oninput" @onkeydown="e => OnKeyAsync(e, w)" @onfocusout="() => SaveAsync(w)" autofocus />
                            }
                            else
                            {
                                <span class="editable" @onclick="() => StartEdit(w.Id, Field.Percent, w.PercentComplete.ToString())">@w.PercentComplete</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="hint">İş adına, efor saatine veya yüzdeye tıklayarak düzenleyin · Enter: kaydet · Esc: vazgeç</p>
    }

    <h2>Bağımlılıklar <span class="count">@Overview.Dependencies.Count</span></h2>
    @if (Overview.Dependencies.Count == 0)
    {
        <p class="muted">Bağımlılık yok. Örn: "Backend bitmeden test başlamasın."</p>
    }
    else
    {
        <ul class="deps">
            @foreach (var d in Overview.Dependencies)
            {
                <li>@Overview.WorkItemName(d.PredecessorId) <span class="muted">→</span> @Overview.WorkItemName(d.SuccessorId)</li>
            }
        </ul>
    }

    }
    else
    {
    <h2>Ekip <span class="count">@Overview.People.Count</span></h2>
    @if (Overview.People.Count == 0)
    {
        <p class="muted">Henüz kişi yok. Ekip üyelerini, becerilerini ve haftalık saatlerini yazın.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Ad</th><th>Beceriler</th><th class="num">Kapasite (s/hafta)</th><th class="num">Saatlik maliyet</th></tr></thead>
            <tbody>
                @foreach (var person in Overview.People)
                {
                    <tr>
                        <td>@person.Name</td>
                        <td>@Format.Flags(person.Skills)</td>
                        <td class="num">@Format.Number(person.WeeklyCapacityHours)</td>
                        <td class="num">@Format.Money(person.HourlyCost, p.Currency)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
    }

@code {
    [Parameter] public ProjectOverview? Overview { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }

    private enum Field { Name, Hours, Percent }

    private enum Tab { Work, Plan, Team }

    private Tab _tab = Tab.Work;

    // Açık olan üst işler; varsayılan: hepsi kapalı (sadece üst seviye görünür, sayfa kısa kalır).
    private readonly HashSet<int> _expanded = [];
    private (int Id, Field Field)? _editing;
    private string _editValue = "";
    private string? _error;
    private bool _saving;

    private bool IsExpanded(int id) => _expanded.Contains(id);

    private void Toggle(int id)
    {
        if (!_expanded.Remove(id))
            _expanded.Add(id);
    }

    private void ExpandAll()
    {
        foreach (var row in Overview!.WorkItemTreeRows.Where(r => r.HasChildren))
            _expanded.Add(row.Item.Id);
    }

    private void CollapseAll() => _expanded.Clear();

    /// <summary>Kapalı bir üst işin altındaki satırlar gizlenir.</summary>
    private IEnumerable<WorkItemTreeRow> VisibleRows()
    {
        int? hiddenBelow = null;
        foreach (var row in Overview!.WorkItemTreeRows)
        {
            if (hiddenBelow is { } depth && row.Depth > depth)
                continue;
            hiddenBelow = row.HasChildren && !IsExpanded(row.Item.Id) ? row.Depth : null;
            yield return row;
        }
    }

    private bool IsEditing(int id, Field field) => _editing == (id, field);

    private void StartEdit(int id, Field field, string value)
    {
        _error = null;
        _editing = (id, field);
        _editValue = value;
    }

    private async Task OnKeyAsync(KeyboardEventArgs e, WorkItemResponse item)
    {
        if (e.Key == "Escape")
            _editing = null;
        else if (e.Key == "Enter")
            await SaveAsync(item);
    }

    private async Task SaveAsync(WorkItemResponse item)
    {
        if (_editing is not { } editing || editing.Id != item.Id || _saving)
            return;
        _saving = true;
        try
        {
            var request = WorkItemRequest.From(item);
            var value = _editValue.Trim();
            switch (editing.Field)
            {
                case Field.Name:
                    if (value.Length == 0)
                        throw new BusinessRuleException("İş adı boş olamaz.");
                    request.Name = value;
                    break;
                case Field.Hours:
                    request.EstimatedHours = ParseNumber(value, "Efor");
                    break;
                case Field.Percent:
                    var percent = ParseNumber(value, "Yüzde");
                    if (percent is < 0 or > 100)
                        throw new BusinessRuleException("Yüzde 0 ile 100 arasında olmalı.");
                    request.PercentComplete = (int)Math.Round(percent);
                    break;
            }

            if (Changed(item, request))
            {
                await Scope.RunAsync<WorkItemService, WorkItemResponse>(
                    s => s.UpdateAsync(item.ProjectId, item.Id, request, CancellationToken.None));
                await OnDataChanged.InvokeAsync();
            }
            _editing = null;
        }
        catch (BusinessRuleException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool Changed(WorkItemResponse item, WorkItemRequest r) =>
        r.Name != item.Name || r.EstimatedHours != item.EstimatedHours || r.PercentComplete != item.PercentComplete;

    private static decimal ParseNumber(string value, string label) =>
        decimal.TryParse(value.Replace(',', '.'), System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture, out var number) && number >= 0
            ? number
            : throw new BusinessRuleException($"{label} için geçerli bir sayı girin.");
}
