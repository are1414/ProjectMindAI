@inject AppScope Scope

@if (Overview is null)
{
    <div class="empty-project">
        <h2>Proje henüz oluşturulmadı</h2>
        <p>Sağdaki sohbete projenizi anlatın. Örneğin:</p>
        <p class="example">"E-ticaret sitesi projesi açalım. 1 Aralık'ta başlasın, 4 ay sürsün, bütçe 2 milyon TL."</p>
        <p class="muted">AI bir öneri kartı hazırlar; <strong>Uygula</strong> dediğinizde proje burada görünür.</p>
        <p class="muted">Ya da sohbet kullanmadan:</p>
        <button class="btn btn-primary" @onclick="OpenCreateProject">Projeyi elle oluştur</button>
    </div>
}
else
{
    var p = Overview.Project;
    <header class="project-header">
        <div>
            <h1>@p.Name</h1>
            <div class="muted">@Format.Name(p.Type) · <span class="badge">@Format.Name(p.Status)</span></div>
            @if (!string.IsNullOrWhiteSpace(p.Description))
            {
                <p class="description">@p.Description</p>
            }
        </div>
        <button class="btn btn-sm" @onclick="OpenEditProject" title="Proje bilgilerini düzenle">Düzenle</button>
    </header>

    <div class="stats">
        <div class="stat"><span>Başlangıç</span><strong>@Format.Date(p.StartDate)</strong></div>
        <div class="stat"><span>Hedef bitiş</span><strong>@Format.Date(p.TargetEndDate)</strong></div>
        <div class="stat"><span>Bütçe</span><strong>@Format.Money(p.Budget, p.Currency)</strong></div>
        <div class="stat"><span>Toplam tahmini efor</span><strong>@Format.Number(Overview.TotalEstimatedHours) saat</strong></div>
    </div>

    <nav class="tabs">
        <button class="tab @(_tab == Tab.Status ? "active" : "")" @onclick="() => _tab = Tab.Status">Durum</button>
        <button class="tab @(_tab == Tab.Work ? "active" : "")" @onclick="() => _tab = Tab.Work">İşler (@Overview.WorkItems.Count)</button>
        <button class="tab @(_tab == Tab.Plan ? "active" : "")" @onclick="() => _tab = Tab.Plan">Plan (Gantt)</button>
        <button class="tab @(_tab == Tab.Team ? "active" : "")" @onclick="() => _tab = Tab.Team">Ekip (@Overview.People.Count)</button>
        <button class="tab @(_tab == Tab.WhatIf ? "active" : "")" @onclick="() => _tab = Tab.WhatIf">What-if</button>
    </nav>

    @if (_tab == Tab.Status)
    {
        <StatusPanel ProjectId="Overview.Project.Id" Overview="Overview" />
    }
    else if (_tab == Tab.WhatIf)
    {
        <WhatIfPanel Overview="Overview" />
    }
    else if (_tab == Tab.Plan)
    {
        <PlanPanel ProjectId="Overview.Project.Id" Overview="Overview" OnDataChanged="OnDataChanged" />
    }
    else if (_tab == Tab.Work)
    {
        <WorkPanel Overview="Overview" OnDataChanged="OnDataChanged" />
    }
    else
    {
        <TeamPanel Overview="Overview" OnDataChanged="OnDataChanged" />
    }
}

@if (_projectForm is not null)
{
    <Modal Title="@(Overview is null ? "Yeni proje" : "Proje bilgilerini düzenle")" OnClose="CloseProjectForm">
        <ProjectForm Model="_projectForm" Error="_projectError" Saving="_saving" OnSubmit="SaveProjectAsync" OnCancel="CloseProjectForm" />
    </Modal>
}

@code {
    [Parameter] public ProjectOverview? Overview { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }

    /// <summary>Panelin sohbeti; elle oluşturulan proje bu sohbete bağlanır (D33).</summary>
    [Parameter] public int SessionId { get; set; }

    /// <summary>Elle oluşturulan projenin önerilen süresi (hedef bitiş tarihi formda değiştirilebilir).</summary>
    private const int DefaultDurationMonths = 3;

    private enum Tab { Status, Work, Plan, Team, WhatIf }

    private Tab _tab = Tab.Status;
    private ProjectRequest? _projectForm;
    private string? _projectError;
    private bool _saving;

    private void OpenCreateProject()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _projectError = null;
        _projectForm = new ProjectRequest
        {
            Type = ProjectType.Other,
            StartDate = today,
            TargetEndDate = today.AddMonths(DefaultDurationMonths)
        };
    }

    private void OpenEditProject()
    {
        _projectError = null;
        _projectForm = ProjectRequest.From(Overview!.Project);
    }

    private void CloseProjectForm()
    {
        _projectForm = null;
        _projectError = null;
    }

    private async Task SaveProjectAsync()
    {
        if (_projectForm is not { } request || _saving)
            return;
        _saving = true;
        _projectError = null;
        try
        {
            await Scope.RunAsync<ChatService, ProjectResponse>(s => s.SaveProjectAsync(SessionId, request, CancellationToken.None));
            _projectForm = null;
            await OnDataChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            _projectError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
